# ========================================
# Apache Configuration
# ========================================

Options -Indexes

# ========================================
# Block development files (reports, build scripts, dependencies)
# These must never be publicly readable. Returned as 404 so they also drop out of search indexes.
# ========================================
# (mod_rewrite is used because the host runs LiteSpeed, which fully supports it)
# ========================================
# Force HTTPS & Redirects
# ========================================
RewriteEngine On

RewriteRule \.md$ - [NC,R=404,L]
RewriteRule ^(scripts|node_modules|src)(/|$) - [NC,R=404,L]
RewriteRule ^(package\.json|package-lock\.json|postcss\.config\.js|tailwind\.config\.js)$ - [NC,R=404,L]

# Redirect Thin Content
RewriteRule ^blog/furniture-packing-tips\.html$ /furniture-packing-jeddah/ [R=301,L]
RewriteRule ^blog/furniture-packing-tips/?$ /furniture-packing-jeddah/ [R=301,L]

# Canonical Domain & Force HTTPS (Redirect www to non-www and force HTTPS)
RewriteCond %{HTTP_HOST} ^www\.khaleejjeddah\.com$ [NC]
RewriteRule ^(.*)$ https://khaleejjeddah.com/$1 [R=301,L]

RewriteCond %{HTTPS} !=on
RewriteRule ^ https://khaleejjeddah.com%{REQUEST_URI} [R=301,L]

# ========================================
# Remove index.html from URL
# ========================================
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

# ========================================
# Pretty URLs (.html hidden)
# ========================================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/.]+)$ $1.html [L]

# ========================================
# Browser Cache
# ========================================
<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"

    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

# ========================================
# GZIP Compression
# ========================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE application/manifest+json
</IfModule>

# ========================================
# Cache-Control Headers
# ========================================
<IfModule mod_headers.c>
    <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|woff2?|ttf|eot)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
</IfModule>

# ========================================
# Security Headers
# ========================================
<IfModule mod_headers.c>

    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # footer.html is an HTML fragment (no <title>, no <head>) kept only as the
    # source for scripts/build-partials.js and as a JS fallback — keep it out of the index.
    <Files "footer.html">
        Header set X-Robots-Tag "noindex, follow"
    </Files>

</IfModule>

# ========================================
# Disable ETags
# ========================================
FileETag None

<IfModule mod_headers.c>
    Header unset ETag
</IfModule>

# ========================================
# Custom Error Pages
# ========================================
ErrorDocument 404 /404.html

# ========================================
# Protect Hidden Files
# ========================================
<FilesMatch "^\.">
    Require all denied
</FilesMatch>